# ==========================================================================
# Copia este fichero como `api/.env` para desarrollo local, o pega estas
# variables en Railway → Variables para producción.
#
# NINGUNA de las de verdad se sube al repositorio: .gitignore excluye `.env`.
# ==========================================================================

# --- acceso ---------------------------------------------------------------

# Client id de OAuth del proyecto de Google (consola de Google Cloud →
# Credenciales → ID de cliente de OAuth → Aplicación web). En «Orígenes
# autorizados de JavaScript» hay que poner http://localhost:4200 y
# http://localhost:8080 para local, y la url del despliegue para producción.
# No es un secreto: viaja al navegador.
BLUEDEBUG_GOOGLE_CLIENT_ID=483023567899-9atrekath4fnmtbvkel4ntfhlqame57j.apps.googleusercontent.com

# Con qué se firma la cookie de sesión. Mínimo 32 caracteres.
# Genéralo con:  openssl rand -base64 48
# Si falta, el panel arranca con uno al azar y las sesiones se caen en cada
# reinicio.
BLUEDEBUG_SECRETO=

# Quién puede entrar. Separados por comas, sin espacios de más.
BLUEDEBUG_PERMITIDOS=bluedebug.develop@gmail.com

# Cuánto dura la sesión.
BLUEDEBUG_HORAS_SESION=12

# En local sobre http tiene que ser false: si no, el navegador tira la cookie
# y el acceso entra en bucle. En producción (https), true.
BLUEDEBUG_COOKIE_SEGURA=false

# Solo para desarrollo, cuando el front va aparte con `npm start`.
BLUEDEBUG_ORIGENES_WEB=http://localhost:4200

# --- VBStats --------------------------------------------------------------

# Su base de datos MySQL. Vale la url de Railway tal cual, la misma que tiene
# el backend de VBStats en MYSQL_PUBLIC_URL.
BLUEDEBUG_VBSTATS_URL=

# Clave de Stripe para leer los cobros. Usa una RESTRINGIDA con permiso de solo
# lectura sobre «Charges»: el panel lee, nunca cobra.
BLUEDEBUG_VBSTATS_STRIPE=

# Cuenta de servicio de Firebase en base64, la misma que usa el backend de
# VBStats en FIREBASE_SERVICE_ACCOUNT_BASE64. Sin ella no se pueden mandar
# notificaciones (todo lo demás sigue funcionando).
BLUEDEBUG_VBSTATS_FIREBASE=

# --- CV Oviedo ------------------------------------------------------------

# Cuenta de servicio del proyecto cv-oviedo, en base64. Se saca de la consola
# de Firebase → Configuración del proyecto → Cuentas de servicio → Generar
# clave privada, y se codifica con:  base64 -w0 clave.json
BLUEDEBUG_CVO_FIREBASE=

# --- opcionales -----------------------------------------------------------

# Cuánto se guardan en caché los resúmenes, en segundos.
BLUEDEBUG_CACHE_SEGUNDOS=60
