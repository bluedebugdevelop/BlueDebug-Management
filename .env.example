# ==========================================================================
# Copia este fichero como `api/.env` para desarrollo local, o pega estas
# variables en Railway → Variables para producción.
#
# NINGUNA de las de verdad se sube al repositorio: .gitignore excluye `.env`.
# ==========================================================================

# --- acceso ---------------------------------------------------------------

# Client id de OAuth del proyecto de Google (consola de Google Cloud →
# Credenciales → ID de cliente de OAuth → Aplicación web). En «Orígenes
# autorizados de JavaScript» hay que poner http://localhost:4200 y
# http://localhost:8080 para local, y la url del despliegue para producción.
# No es un secreto: viaja al navegador.
BLUEDEBUG_GOOGLE_CLIENT_ID=

# Con qué se firma la cookie de sesión. Mínimo 32 caracteres.
# Genéralo con:  openssl rand -base64 48
# Si falta, el panel arranca con uno al azar y las sesiones se caen en cada
# reinicio.
BLUEDEBUG_SECRETO=

# Quién puede entrar. Separados por comas, sin espacios de más.
BLUEDEBUG_PERMITIDOS=bluedebug.develop@gmail.com

# Cuánto dura la sesión.
BLUEDEBUG_HORAS_SESION=12

# En local sobre http tiene que ser false: si no, el navegador tira la cookie
# y el acceso entra en bucle. En producción (https), true.
BLUEDEBUG_COOKIE_SEGURA=false

# Solo para desarrollo, cuando el front va aparte con `npm start`.
BLUEDEBUG_ORIGENES_WEB=http://localhost:4200

# --- VBStats --------------------------------------------------------------

# Su base de datos MySQL. Vale la url de Railway tal cual, la misma que tiene
# el backend de VBStats en MYSQL_PUBLIC_URL.
BLUEDEBUG_VBSTATS_URL=

# Clave de Stripe para leer los cobros. Usa una RESTRINGIDA con permiso de solo
# lectura sobre «Charges»: el panel lee, nunca cobra.
BLUEDEBUG_VBSTATS_STRIPE=

# Cuenta de servicio de Firebase en base64, la misma que usa el backend de
# VBStats en FIREBASE_SERVICE_ACCOUNT_BASE64. Sin ella no se pueden mandar
# notificaciones (todo lo demás sigue funcionando).
BLUEDEBUG_VBSTATS_FIREBASE=

# --- App Store: el otro sitio por donde cobra VBStats ---------------------
# La base de datos no guarda importes de Apple, solo el id de transaccion de
# cada cuenta, asi que el dinero hay que pedirselo a Apple.
# App Store Connect -> Usuarios y acceso -> Integraciones -> Compras dentro de
# la app -> +. El .p8 solo se descarga UNA VEZ.
# Las cuatro van juntas: con tres no se puede firmar el token.
BLUEDEBUG_APPLE_ISSUER=
BLUEDEBUG_APPLE_KEY_ID=
# El fichero .p8 en base64 (mismo comando que las cuentas de servicio).
BLUEDEBUG_APPLE_P8=
BLUEDEBUG_APPLE_BUNDLE=
# true para hablar con el entorno de pruebas de Apple.
BLUEDEBUG_APPLE_SANDBOX=false

# --- CV Oviedo ------------------------------------------------------------

# Cuenta de servicio del proyecto cv-oviedo, en base64. Se saca de la consola
# de Firebase → Configuración del proyecto → Cuentas de servicio → Generar
# clave privada, y se codifica con:  base64 -w0 clave.json
BLUEDEBUG_CVO_FIREBASE=

# --- contabilidad ---------------------------------------------------------

# La base de datos de los gastos de la empresa. Es la ÚNICA base de datos propia
# del panel: las de arriba son de las apps y solo se leen.
#
# En Railway: «+ New» → «Database» → Postgres, y se copia su DATABASE_PUBLIC_URL
# aquí tal cual. También vale un MySQL (el mismo servidor de VBStats sirve, con
# otra base): se detecta por el esquema de la url, postgresql:// o mysql://.
# La tabla se crea sola la primera vez.
#
# Si se deja vacía, la sección de Contabilidad sale apagada explicando qué falta
# y el resto del panel funciona igual.
BLUEDEBUG_CONTABILIDAD_URL=

# Solo si la url es de tipo jdbc: y no lleva las credenciales dentro.
BLUEDEBUG_CONTABILIDAD_USUARIO=
BLUEDEBUG_CONTABILIDAD_CLAVE=

# Quién puede figurar como pagador de un gasto, separados por comas. Es una
# lista cerrada para que el reparto cuadre: con texto libre, «Adrián» y «adrian»
# serían dos socios distintos.
#
# OJO al cambiar un nombre: los gastos ya apuntados guardan el nombre con el que
# se grabaron, así que renombrar a alguien aquí deja sus gastos antiguos a nombre
# del texto viejo. Se ven igual en el reparto, pero como una persona aparte.
BLUEDEBUG_SOCIOS=Adrián Estrada,Diego Charro,Rubén Rubio

# --- opcionales -----------------------------------------------------------

# Cuánto se guardan en caché los resúmenes, en segundos.
BLUEDEBUG_CACHE_SEGUNDOS=60

# --- traduccion (opcional) ------------------------------------------------

# Traducir al inglés, el francés y el portugués lo que se escribe en castellano
# en los formularios (novedades de versión, por ahora). Ocurre al publicar, sin
# pulsar nada. Sin ninguna de las dos claves se publica solo en castellano y los
# cuatro idiomas de la app lo leerán en castellano.

# El motor GRATIS, y el que se usa si está puesto. Se saca de aistudio.google.com
# → Get API key. La capa gratuita da de sobra para esto: seis titulares cada vez
# que se publica una versión.
GEMINI_API_KEY=

# El de pago, solo hace falta si no hay clave de Gemini. De console.anthropic.com.
ANTHROPIC_API_KEY=

# Cuál usar: auto (el que haya, prefiriendo el gratis) | gemini | claude
BLUEDEBUG_TRADUCCION_MOTOR=auto

# Los modelos. Fuera del código porque estos nombres cambian cada pocos meses y
# no vale la pena desplegar por eso.
BLUEDEBUG_GEMINI_MODELO=gemini-3.5-flash-lite
BLUEDEBUG_TRADUCCION_MODELO=claude-opus-5
